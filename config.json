        "enabled": true,
        "rule_type": "custom",
        "is_multi_value": false,
        "selector": "",
        "attribute": "",
        "html_snippet": "",
        "placeholder": "",
        "pattern": "",
        "group_index": 1,
        "code": "text = soup.find('span', class_='header', string='長度:').next_sibling.strip()\n\n# 支持 \"140分鐘\" 或 \"2小時30分鐘\" 格式\nhours = re.search(r'(\\d+)\\s*小時', text)\nminutes = re.search(r'(\\d+)\\s*分鐘', text)\n\ntotal_seconds = 0\nif hours:\n    total_seconds += int(hours.group(1)) * 3600\nif minutes:\n    total_seconds += int(minutes.group(1)) * 60\n\nresult = total_seconds",
